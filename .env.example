# Copy to .env (chmod 600). Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
APP_PORT=3100
PUBLIC_SITE_URL=https://new.atollrentacar.com
SITE_ENV=staging            # staging => robots disallow all
BUSINESS_TZ=Asia/Famagusta
MEDIA_DIR=/srv/atoll/media
IMPORT_DIR=/srv/atoll/import
# CA of the FortiGate SSL inspection, used only while building images
CORP_CA_FILE=/usr/local/share/ca-certificates/fortinet_ca.crt
# Stripe (deposit). Leave empty to run "pay at pick-up" only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tests only — separate database (tables are wiped)
DATABASE_URL_TEST=
# Cloudflare Turnstile on the booking form (Cloudflare dashboard > Turnstile > Add widget, hostname new.atollrentacar.com).
# Leave empty to rely on honeypot + fill-time + rate-limit checks only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# --- AI assistant (Claude API). The key stays on the server only; never in git, chat or logs. ---
# Master switch; the owner also has to turn it on in /admin/assistant.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# USD per million tokens for ANTHROPIC_MODEL (Anthropic pricing page; Haiku 5.5, prompts <=100K, Oct 2026)
CHAT_PRICE_INPUT_PER_MTOK=0.10
CHAT_PRICE_OUTPUT_PER_MTOK=0.50
CHAT_PRICE_CACHE_READ_PER_MTOK=0.01
# Cache write defaults to 1.25 x input when empty
CHAT_PRICE_CACHE_WRITE_PER_MTOK=
# Hard spend limits (USD); the assistant stops calling the API when reached and shows phone/WhatsApp
CHAT_DAILY_BUDGET_USD=1
CHAT_MONTHLY_BUDGET_USD=10
CHAT_MAX_INPUT_LENGTH=1000
CHAT_MAX_OUTPUT_TOKENS=1000
CHAT_MAX_TOOL_ROUNDS=4
CHAT_RETENTION_DAYS=90
# --- E-mail (bookings, contact form, assistant requests go to NOTIFY_EMAILS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REQUIRE_TLS=true
NOTIFY_EMAILS=
